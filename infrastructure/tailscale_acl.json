{
  "grants": [
    {
      "src": ["dominic.egginton@gmail.com"],
      "dst": ["tag:service-idp"],
      "ip":  ["*"],
      "app": {
        "tailscale.com/cap/tsidp": [
          {
            "allow_admin_ui":    true,
            "allow_dcr":         true,
            "extraClaims":       {"immich_role": "admin"},
            "includeInUserInfo": true,
            "resources":         ["*"],
            "users":             ["*"]
          }
        ]
      }
    },

    {
      "src": ["*"],
      "dst": ["tag:service-idp"],
      "ip":  ["*"]
    },

    {
      "src": [
        "dominic.egginton@gmail.com",
        "tag:device-latitude-7390"
      ],
      "dst": ["tag:service-frigate"],
      "ip":  ["tcp:443"]
    },

    {
      "src": [
        "dominic.egginton@gmail.com",
        "tag:device-latitude-7390"
      ],
      "dst": ["autogroup:tagged"],
      "ip":  ["tcp:22"]
    },

    {
      "src": [
        "dominic.egginton@gmail.com",
        "tag:device-latitude-7390"
      ],
      "dst": ["tag:service-silverbullet"],
      "ip":  ["tcp:443"]
    },

    {
      "src": [
        "dominic.egginton@gmail.com", 
        "tag:device-latitude-7390",
        "tag:device-steamdeck",
        "tag:device-steammachine"
      ],
      "dst": ["tag:service-jellyfin"],
      "ip":  ["*"]
    },

    {
      "src": [
        "dominic.egginton@gmail.com", 
        "tag:device-latitude-7390",
        "tag:device-steamdeck",
        "tag:device-steammachine"
      ],
      "dst": ["tag:service-transmission"],
      "ip":  ["*"]
    },

    {
      "src": ["*"],
      "dst": ["tag:service-immich"],
      "ip":  ["*"]
    },

    {
      "src": ["*"],
      "dst": ["tag:service-cache"],
      "ip":  ["*"]
    }
  ],

  "postures": {
    "posture:device-posture": [
      "node:tsVersion >= '1.98.0'",
      "node:osVersion >= '6.18.0'",
      "node:tsStateEncrypted == true",
      "node:tsReleaseTrack == 'stable'"
    ]
  },

  "tagOwners": {
    "tag:device-ghost-gs60":    ["autogroup:admin"],
    "tag:device-latitude-7390": ["autogroup:admin"],
    "tag:device-steamdeck":     ["autogroup:admin"],
    "tag:device-steammachine":  ["autogroup:admin"],
    "tag:service-idp":          ["autogroup:admin"],
    "tag:service-immich":       ["autogroup:admin"],
    "tag:immich-user":          ["autogroup:admin"],
    "tag:service-silverbullet": ["autogroup:admin"],
    "tag:service-frigate":      ["autogroup:admin"],
    "tag:service-jellyfin":     ["autogroup:admin"],
    "tag:service-cache":        ["autogroup:admin"],
    "tag:service-transmission": ["autogroup:admin"]
  },

  "ssh": [
    {
      "src": [
        "tag:device-latitude-7390",
        "dominic.egginton@gmail.com"
      ],
      "dst":    ["autogroup:tagged"],
      "users":  ["autogroup:nonroot", "root", "dom"],
      "action": "accept"
    }
  ],

  "autoApprovers": {"exitNode": []},

  "nodeAttrs": [
    {
      "target": ["tag:service-idp", "tag:service-immich", "tag:service-jellyfin"],
      "attr":   ["funnel"]
    }
  ],

  "tests": [
    {
      "src": "dominic.egginton@gmail.com",
      "accept": [
        "tag:service-transmission:80",
        "tag:service-frigate:443",
        "tag:service-silverbullet:443",
        "tag:service-idp:80"
      ]
    },
    {
      "src": "tag:device-latitude-7390",
      "accept": [
        "tag:service-transmission:80",
        "tag:service-frigate:443",
        "tag:service-jellyfin:8080"
      ]
    }
  ],

  "sshTests": [
    {
      "src": "dominic.egginton@gmail.com",
      "dst": ["tag:device-latitude-7390"],
      "accept": ["root", "dom"]
    },
    {
      "src": "tag:device-latitude-7390",
      "dst": ["tag:device-ghost-gs60"],
      "accept": ["root", "dom"]
    }
  ]
}
